        }

        /* Lock down pygbag console/debug panels so players cannot break out of loader */
        #transfer, #crt, #system, #box, #info, #pyconsole, #terminal, #dlg, #html {
            display: none !important;
            visibility: hidden !important;
            pointer-events: none !important;
        }
    </style>


import sys
import asyncio
import platform
import json
from pathlib import Path

# do not rename
async def custom_site():
    import embed
    platform.document.body.style.background = "#0d111a"

    platform.window.transfer.hidden = True
    platform.window.canvas.style.visibility = "visible"

    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    def set_progress(pct):
        try:
            bar = platform.document.getElementById("cm_bar_fill")
            if bar is not None:
                bar.style.width = f"{pct}%"
        except Exception:
            pass

    platform.window.infobox.innerText = "Loading assets..."
    set_progress(25)

    if platform.window.location.host.find('.itch.zone') > 0:
        import zipfile
        async with platform.fopen("{{cookiecutter.archive}}.apk", "rb") as archive:
            with zipfile.ZipFile(archive) as zip_ref:
                zip_ref.extractall(appdir.as_posix())
    else:
        import tarfile
        async with platform.fopen("{{cookiecutter.archive}}.tar.gz", "rb") as archive:
            tar = tarfile.open(fileobj=archive, mode="r:gz")
            tar.extractall(path=appdir.as_posix(), filter='tar')
            tar.close()

    platform.window.infobox.innerText = "Starting Python..."
    set_progress(55)
    platform.run_main(PyConfig, loaderhome=appdir / "assets", loadermain=None)

    while embed.counter() < 0:
        await asyncio.sleep(.05)

    main = appdir / "assets" / "main.py"
    set_progress(80)

    if not platform.window.MM.UME:
        __import__(__name__).__file__ = main
        set_progress(100)
        platform.window.infobox.innerText = "Click anywhere to start"
        try:
            platform.window.infobox.className = "cm-status cm-ready"
        except Exception:
            pass
        while not platform.window.MM.UME:
            await asyncio.sleep(.05)

    platform.window.infobox.innerText = "Loading game..."
    set_progress(95)
    await TopLevel_async_handler.start_toplevel(platform.shell, console=0)

    __import__(__name__).__file__ = main

    def ui_callback(pkg):
        platform.window.infobox.innerText = f"Loading {pkg}..."

    await shell.source(main, callback=ui_callback)
    set_progress(100)

    platform.window.infobox.style.display = "none"
    overlay = platform.document.getElementById("loading_overlay")
    if overlay is not None:
        overlay.style.display = "none"
    platform.window.canvas.style.pointerEvents = "auto"
    platform.window.config.gui_divider = 1
    platform.window.window_resize()

asyncio.run(custom_site())


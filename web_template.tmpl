</head>

<body oncontextmenu="return false;">
    <div id="loading_overlay">
        <div class="cm-card">
            <h1 class="cm-title">Cheque Mate</h1>
            <div class="cm-bar-track">
                <div id="cm_bar_fill" class="cm-bar-fill"></div>
            </div>
            <div id="infobox" class="cm-status">Loading...</div>
        </div>
    </div>

    <!-- Required by pygbag runtime loader (kept visually hidden) -->
    <div id="transfer" align="center" hidden>
        <div id="status">Downloading...</div>
        <progress value="0" max="100" id="progress"></progress>
    </div>

    <canvas class="emscripten" id="canvas" width="1280" height="720" oncontextmenu="event.preventDefault()" tabindex="1"></canvas>
    <canvas class="emscripten" id="canvas3d" width="1280px" height="720px" oncontextmenu="event.preventDefault()" tabindex="1" hidden></canvas>

    <div id="html"></div>
    <div id="crt" class="bottomright" hidden>
        <div id="system" hidden>
            <button id="aiostop" disabled></button>
            <button id="aiopaused_true" disabled></button>
            <button id="aiopaused_false" disabled></button>
            <button id="pygame_mixer_music_pause" disabled></button>
            <div id="load_min"></div>
            <div id="load_avg"></div>
            <div id="load_max"></div>
            <button id="load_rst" disabled></button>
            <div id="level"></div>
            <div id="stateBattery"></div>
        </div>
        <div id="box" hidden>
            <div id="info"></div>
            <iframe id="iframe" name="iframe"></iframe>
        </div>
    </div>
    <div id="dlg" hidden>
        <input type="file" id="dlg_multifile" multiple accept="image/*">
    </div>
    <div id="pyconsole" hidden>
        <div id="terminal" tabIndex="-1"></div>
    </div>

    <script type="application/javascript">
    globalThis.__canvas_resized = () => {};
    globalThis.debug = () => {};

    async function custom_onload() {
        show_infobox();
    }
    function custom_prerun() {}
    function custom_postrun() {}

    (() => {
        const overlay = document.getElementById("loading_overlay");
        const ib = document.getElementById("infobox");
        const barFill = document.getElementById("cm_bar_fill");
        const prog = document.getElementById("progress");
        const canvas = document.getElementById("canvas");

        const fitCanvas = () => {
            if (!canvas) return;
            const ar = 1280 / 720;
            const vw = Math.max(320, window.innerWidth || 1280);
            const vh = Math.max(180, window.innerHeight || 720);
            let w = vw;
            let h = Math.floor(w / ar);
            if (h > vh) {
                h = vh;
                w = Math.floor(h * ar);
            }
            const targetW = w + "px";
            const targetH = h + "px";
            if (canvas.style.width !== targetW) canvas.style.width = targetW;
            if (canvas.style.height !== targetH) canvas.style.height = targetH;
            canvas.style.position = "absolute";
            canvas.style.left = "0";
            canvas.style.right = "0";
            canvas.style.top = "0";
            canvas.style.bottom = "0";
            canvas.style.margin = "auto";
        };
        window.addEventListener("resize", fitCanvas);
        if (canvas) {
            new MutationObserver(fitCanvas).observe(canvas, {
                attributes: true,
                attributeFilter: ["width", "height"]
            });
        }
        fitCanvas();

        // Block Escape / Space / arrow / Tab keys from scrolling or breaking out while loading overlay is active
        window.addEventListener("keydown", (e) => {
            if (overlay && overlay.style.display !== "none") {
                if (["Escape", "Space", " ", "Tab", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(e.key)) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            }
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "c") {
                e.stopPropagation();
            }
        }, true);

        const syncProgress = () => {
            if (!overlay || overlay.style.display === "none") return;
            if (ib && ib.style.display === "none") {
                overlay.style.display = "none";
                if (canvas) canvas.style.pointerEvents = "auto";
                return;
            }
            if (prog && barFill && prog.max > 0 && prog.value > 0) {
                const pct = Math.max(12, Math.min(100, (prog.value / prog.max) * 100));
                barFill.classList.remove("cm-indet");
                barFill.style.width = pct.toFixed(1) + "%";
            }
        };

        if (ib) {
            new MutationObserver(syncProgress).observe(ib, {
                attributes: true,
                attributeFilter: ["style", "class"]
            });
        }
        setInterval(syncProgress, 100);
    })();
    </script>
</body>

function show_infobox() {
    const overlay = document.getElementById("loading_overlay");
    if (overlay) {
        overlay.style.display = "flex";
    }
    const ib = document.getElementById("infobox");
    if (ib) {
        ib.style.display = "block";
    }
}

window.cmMusic = {
    audio: new Audio(),
    currentSrc: "",
    endedFlag: false,
    wantPlay: false,
    play: function(url, vol) {
        try {
            this.endedFlag = false;
            this.wantPlay = true;
            if (this.currentSrc !== url) {
                this.currentSrc = url;
                this.audio.src = url;
            }
            this.audio.loop = false;
            this.audio.volume = Math.max(0, Math.min(1, vol));
            this.audio.currentTime = 0;
            const p = this.audio.play();
            if (p && p.catch) { p.catch(function(){}); }
            return true;
        } catch (e) { return false; }
    },
    setVolume: function(vol) {
        try {
            this.audio.volume = Math.max(0, Math.min(1, vol));
            if (vol > 0 && this.wantPlay && this.audio.paused && !this.endedFlag && this.currentSrc) {
                const p = this.audio.play();
                if (p && p.catch) { p.catch(function(){}); }
            }
        } catch (e) {}
    },
    isBusy: function() {
        if (!this.currentSrc) return false;
        return !this.endedFlag && !this.audio.ended;
    }
};
window.cmMusic.audio.addEventListener("ended", function() {
    window.cmMusic.endedFlag = true;
});
</script>

